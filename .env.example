# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进仓库。

# 默认使用 DeepSeek 的 OpenAI-compatible API。
ARGUS_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：覆盖默认模型。不填则用 deepseek-chat。
# ARGUS_AGENT_MODEL=deepseek-chat
# ARGUS_JUDGE_MODEL=deepseek-chat

# 如果仍要跑旧版 Anthropic Agent，可改回：
# ARGUS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
